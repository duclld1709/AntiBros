# Copy to .env (never commit it). Read by `antibros` and by docker compose.

# Which pipeline config and model profile `docker compose up` serves. The provider is chosen
# by the model profile (configs/models/*.yaml: ollama | openai_compatible | gemini | fake),
# so switching to a hosted API means pointing ANTIBROS_MODELS at another profile; no code change.
ANTIBROS_CONFIG=configs/docker.yaml
ANTIBROS_MODELS=configs/models/laptop.yaml

# LLM endpoint. Native Ollama for Windows: http://127.0.0.1:11434/v1 on the host;
# inside Docker containers http://host.docker.internal:11434/v1 (the compose default).
# With `docker compose --profile ollama up` (Linux): http://ollama:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Only needed for hosted APIs (never commit real keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional Langfuse remote tracing (use only when tracing.backend=langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Qdrant (the compose services use http://qdrant:6333)
QDRANT_URL=http://127.0.0.1:6333
# Optional: move Ollama model storage off C:
# OLLAMA_MODELS=D:\ollama\models
