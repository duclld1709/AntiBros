# LLM provider: openai_compatible | gemini | fake
LLM_PROVIDER=openai_compatible
# Native Ollama for Windows. Inside Docker containers use http://host.docker.internal:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Only needed for hosted APIs (never commit real keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Qdrant
QDRANT_URL=http://127.0.0.1:6333
# Optional: move Ollama model storage off C:
# OLLAMA_MODELS=D:\ollama\models
